# Copy to .env.local and fill in. These are public values (bundled into the site).
VITE_SUPABASE_URL=https://ybyepepysojbtqlxmgfp.supabase.co
VITE_SUPABASE_ANON_KEY=
VITE_API_URL=https://api-dev.ollarai.com
# Google OAuth web client ID (same one set in Supabase > Auth > Providers > Google)
VITE_GOOGLE_CLIENT_ID=
# Paddle client-side token (Developer tools > Authentication). test_... = sandbox, live_... = live
VITE_PADDLE_CLIENT_TOKEN=
# Paddle price of the Pro plan (Catalog > Products > Pro > Prices, pri_...)
VITE_PADDLE_PRICE_ID=
# PortOne (Korean pricing page, KG Inicis billing key). Console > 연동 정보: store-... and the
# KG이니시스 channel's key (test channel = INIBillTst until the merchant review passes, then the live one)
VITE_PORTONE_STORE_ID=
VITE_PORTONE_CHANNEL_KEY=
